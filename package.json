{
  "name": "roo-code",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web-roo-code",
    "build": "npm run build --workspace=apps/web-roo-code",
    "start": "npm run start --workspace=apps/web-roo-code",
    "lint": "npm run lint --workspace=apps/web-roo-code",
    "clean": "rimraf dist out bin .vite-port .turbo"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@dotenvx/dotenvx": "^1.34.0",
    "@roo-code/config-typescript": "*",
    "@types/glob": "^9.0.0",
    "@types/node": "^24.1.0",
    "@vscode/vsce": "3.3.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.27.0",
    "glob": "^11.1.0",
    "mkdirp": "^3.0.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "5.8.3"
  },
  "overrides": {
    "tar-fs": ">=3.1.1",
    "esbuild": ">=0.25.0",
    "undici": ">=5.29.0",
    "brace-expansion": "^2.0.2",
    "form-data": ">=4.0.4",
    "bluebird": ">=3.7.2",
    "glob": ">=11.1.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.5",
    "zod": "3.25.76"
  }
